[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/title_screen.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="panel"]
bg_color = Color(0.055, 0.07, 0.12, 0.94)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 0.3, 0.06, 0.8)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_right = 18
corner_radius_bottom_left = 18

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.035, 0.025, 0.065, 1)
mouse_filter = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(570, 620)
layout_mode = 2
theme_override_styles/panel = SubResource("panel")

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 42
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 42
theme_override_constants/margin_bottom = 30

[node name="Content" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Panel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.34, 0.08, 1)
theme_override_font_sizes/font_size = 48
text = "THE FLOOR IS LAVA"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.75, 0.54, 1)
text = "RUN HIGH. STAY COOL. DON'T GET TOASTED."
horizontal_alignment = 1

[node name="BeanPreview" type="Panel" parent="Center/Panel/Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
modulate = Color(0.435, 0.894, 1, 1)

[node name="Eyes" type="Label" parent="Center/Panel/Margin/Content/BeanPreview"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_colors/font_color = Color(0.04, 0.04, 0.08, 1)
theme_override_font_sizes/font_size = 42
text = "◉   ◉"
horizontal_alignment = 1
vertical_alignment = 1

[node name="ColourLabel" type="Label" parent="Center/Panel/Margin/Content"]
layout_mode = 2
text = "BEAN COLOUR"

[node name="ColorRow" type="HBoxContainer" parent="Center/Panel/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 14

[node name="EyeLabel" type="Label" parent="Center/Panel/Margin/Content"]
layout_mode = 2
text = "FUNNY EYES"

[node name="EyeOption" type="OptionButton" parent="Center/Panel/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2

[node name="Host" type="Button" parent="Center/Panel/Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "HOST A LAVA RUN"

[node name="Join" type="Button" parent="Center/Panel/Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "JOIN A FRIEND"

[node name="JoinPanel" type="VBoxContainer" parent="Center/Panel/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2

[node name="JoinCode" type="LineEdit" parent="Center/Panel/Margin/Content/JoinPanel"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Peak Code"

[node name="StartJoin" type="Button" parent="Center/Panel/Margin/Content/JoinPanel"]
layout_mode = 2
text = "DIVE IN"

[node name="Status" type="Label" parent="Center/Panel/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
horizontal_alignment = 1

[connection signal="item_selected" from="Center/Panel/Margin/Content/EyeOption" to="." method="_on_eye_option_item_selected"]
[connection signal="pressed" from="Center/Panel/Margin/Content/Host" to="." method="_on_host_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/Content/Join" to="." method="_on_join_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/Content/JoinPanel/StartJoin" to="." method="_on_start_join_pressed"]
