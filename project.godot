; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lava is the Floor"
config/description="A Multiplayer \"lava is the floor\" type game."
run/main_scene="uid://yv267dbktknq"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/stretch_mode=4
boot_splash/image="uid://c78dv6tbt4jlq"
config/icon="uid://c78dv6tbt4jlq"

[autoload]

PlayerCustomization="*uid://cj5vm55hnayfm"
Noray="*uid://gu4bv4tgms3x"
PacketHandshake="*uid://tt3j25a05n7c"
UISound="*res://globals/ui_sound.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=2

[editor_plugins]

enabled=PackedStringArray("res://addons/go_placer/plugin.cfg", "res://addons/netfox.internals/plugin.cfg", "res://addons/netfox.noray/plugin.cfg")

[file_customization]

folder_colors={
"res://Archive/": "purple",
"res://addons/": "gray",
"res://assets/": "yellow",
"res://globals/": "blue",
"res://music/": "pink",
"res://palettes/": "teal",
"res://scenes/": "orange",
"res://scripts/": "green",
"res://sfx/": "red",
"res://shaders/": "purple"
}

